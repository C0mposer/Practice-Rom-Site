# Creator preview passphrase — append to the site URL manually, e.g. ?creator=your-key-here
VITE_CREATOR_BYPASS_KEY=change-me-before-deploy

# Ghost replay downloads — sheet is read live via Google gviz (publish sheet to the web).
# VITE_GHOST_REPLAY_SHEET_ID=1FRsIFruvudBQzKBPcCEm27SErnol9FkRNUDLPE_SKMI
# VITE_GHOST_REPLAY_SHEET_GID=0

# Google Drive folder with .bin ghosts (for npm run sync:ghosts → public/ghost-drive-manifest.json)
# GHOST_DRIVE_FOLDER_ID=your_folder_id
# GOOGLE_API_KEY=your_google_cloud_api_key

# Optional fallback if not using Drive links in the sheet or manifest
# VITE_GHOST_REPLAY_FILE_BASE_URL=
